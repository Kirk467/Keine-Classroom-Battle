window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://buttons/": "teal",
"res://cards/": "teal",
"res://shared/": "purple",
"res://stats/": "teal"
}

[gui]

theme/custom_font="uid://cwe6fw8q4tacs"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
